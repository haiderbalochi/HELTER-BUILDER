# ============================================================================
#  HAIDER BALOCH — PORTFOLIO · ENVIRONMENT
# ----------------------------------------------------------------------------
#  Copy this file to `.env` and fill in the values.
#  Every variable MUST be prefixed with VITE_ to reach the browser bundle.
#  NEVER commit the real `.env` file.
# ============================================================================

# ---------------------------------------------------------------------------
#  FIREBASE  (project: haider-baloch)
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=haider-baloch.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=haider-baloch
VITE_FIREBASE_STORAGE_BUCKET=haider-baloch.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=34768683508
VITE_FIREBASE_APP_ID=1:34768683508:web:24ec0a250bde42cdb9b9a1
VITE_FIREBASE_MEASUREMENT_ID=G-3VSGFMDSNP

# ⚠️  ACTION REQUIRED — MISSING VALUE
# The Firebase Web API key was NOT supplied with the project brief.
# Get it from: Firebase Console → Project settings → General → Your apps → Web API key
# Without it the reviews system and admin login cannot talk to Firebase.
# The site will still build and run — those features show a clear
# "not configured" state instead of crashing.

# ---------------------------------------------------------------------------
#  ADMIN ROUTE  →  /hideadmin
# ---------------------------------------------------------------------------
# Admin account. Prefills the /hideadmin login field and must match the
# Firebase Authentication user created by `npm run admin:setup`.
VITE_ADMIN_EMAIL=meramobile058@gmail.com

# UID of the admin user, created via `npm run admin:create`.
# Required by `firestore.rules` for approve / reject / delete / edit.
VITE_ADMIN_UID=

# ---------------------------------------------------------------------------
#  OPTIONAL — analytics / deployment
# ---------------------------------------------------------------------------
# VITE_SITE_URL=https://haiderbaloch.dev
